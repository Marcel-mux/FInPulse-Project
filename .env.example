# ============================================================
# FinPulse - Database Environment Configuration
# ============================================================

# Opsi 1: Turso Cloud Database (Direkomendasikan untuk Vercel Serverless)
# Dapatkan DATABASE_URL dan TURSO_AUTH_TOKEN dari dashboard Turso (turso db show / turso db tokens create)
DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your_turso_jwt_auth_token"

# Opsi 2: SQLite Lokal (Untuk development offline)
# DATABASE_URL="file:./dev.db"

# ============================================================
# NextAuth Authentication Configuration
# ============================================================
# Generate string 32-byte acak: `openssl rand -base64 32`
NEXTAUTH_SECRET="your_nextauth_secret_key_here"

# Canonical URL aplikasi (localhost untuk dev, domain Vercel untuk production)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://f-in-pulse-project.vercel.app"

# ============================================================
# Google Gemini AI Configuration (WhatsApp Bot Parser)
# ============================================================
# Dapatkan API Key gratis di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
